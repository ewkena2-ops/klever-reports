rules_version = '2';

/* Klever chat — who may read and write what.

   This file is the real lock. js/channels.js decides what the phone offers to
   show; these rules decide what the server will actually hand over. Someone
   editing the JavaScript in their browser changes the first and not the
   second. Keep that distinction in mind before moving a check out of here.

   Identity is the account's email local-part: betty@klever.local is betty.
   The Chairman is chairman@klever.local.

   Messages cannot be edited or deleted by anyone, including the Chairman and
   including the person who wrote them. That is deliberate — this log feeds
   the penalty ledger, and a record that can be revised afterwards is not
   evidence of anything. To correct something, write another message.

   PASTE THIS INTO: Firebase console -> Firestore Database -> Rules -> Publish.  */

service cloud.firestore {
  match /databases/{database}/documents {

    /* Who may be anyone at all. Identity is the part of the email before
       the @ — so the part after it must be ours, and the name must be one of
       ours. Without this, anybody who could register chairman@anywhere.com
       would be the Chairman here. Adding a person means adding their id to
       this list, to CHAT_ACCOUNTS in js/channels.js, and creating their
       account in the Firebase console. */
    function known(id) {
      return id in ['chairman', 'ledger',
                    'ephrata', 'liu', 'betty', 'seble', 'getachew', 'yordanos',
                    'amaha', 'wude', 'elyas', 'ashenafi', 'tsega', 'biruktayet',
                    'yohannis', 'yonas', 'abrham-g', 'teklweld', 'abrham-w',
                    /* the sixth designer, 6 Oct 2026 */
                    'ermiyas',
                    /* Group Finance Controller, 6 Oct 2026 */
                    'kidan',
                    /* Rovestone's Operations Lead, added 4 Oct 2026 — and
                       left out of this list until the 5 Oct live test found
                       every report of hers refused */
                    'frewoyni'];
    }

    function signedIn() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email is string
          && request.auth.token.email.lower().matches('^[a-z0-9-]+@klever[.]local$')
          && known(request.auth.token.email.lower().split('@')[0]);
    }

    /* the Klever id behind the account doing the asking */
    function me() {
      return request.auth.token.email.split('@')[0].lower();
    }

    function isChairman() {
      return signedIn() && me() == 'chairman';
    }

    /* The penalty ledger's own account. It reads filed reports and nothing
       else — it cannot write one, cannot touch chat, and cannot alter
       anything. It exists so that the nightly job does not have to carry the
       Chairman's password around in a script property, and so that if it ever
       leaks, what leaks is a reader. */
    function isLedger() {
      return signedIn() && me() == 'ledger';
    }

    /* one read of the channel document, cached for the rest of this request */
    function memberOf(cid) {
      return signedIn()
          && me() in get(/databases/$(database)/documents/channels/$(cid)).data.members;
    }

    match /channels/{cid} {

      /* you can see a channel you are in. Note this covers `get` only — the
         app never lists channels from the server, it builds the list from
         channels.js, so there is no listing to protect here. */
      allow get: if signedIn() && me() in resource.data.members;

      /* only the Chairman defines channels and who is in them. This is the
         Set up channels button on his phone. */
      allow list, create, update: if isChairman();
      allow delete: if false;

      match /messages/{mid} {

        allow read: if memberOf(cid);

        allow create: if memberOf(cid)
                      /* you can only write as yourself */
                      && request.resource.data.who == me()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 4000
                      /* the time comes from the server, so nobody can file a
                         message as though it were sent before a deadline */
                      && request.resource.data.at == request.time
                      && request.resource.data.keys().hasOnly(
                           ['who','text','lang','at','kind','media','mime','dur','w','h'])
                      /* the small fields are what they claim to be */
                      && (!('lang' in request.resource.data)
                          || (request.resource.data.lang is string && request.resource.data.lang.size() <= 8))
                      && (!('mime' in request.resource.data)
                          || (request.resource.data.mime is string && request.resource.data.mime.size() <= 80))
                      && (!('dur' in request.resource.data) || request.resource.data.dur is number)
                      && (!('w' in request.resource.data) || request.resource.data.w is number)
                      && (!('h' in request.resource.data) || request.resource.data.h is number)
                      /* either it says something, or it carries something */
                      && (
                           (!('kind' in request.resource.data)
                             && !('media' in request.resource.data)
                             && request.resource.data.text.size() > 0)
                           ||
                           (request.resource.data.kind in ['image','voice']
                             && request.resource.data.media is string
                             /* a Firestore document caps at 1 MiB and base64
                                inflates by a third, so the client shrinks a
                                photo until it fits. This is the backstop —
                                without it one oversized send makes a channel
                                expensive for every phone that opens it. */
                             && request.resource.data.media.size() <= 700000
                             /* and it is carried in the message itself. An
                                address to somebody's server would make every
                                reader's phone call it — telling that server
                                who read the channel, and when — and the
                                picture could be changed after it was sent. */
                             && (request.resource.data.kind == 'image'
                                 ? request.resource.data.media.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
                                 : request.resource.data.media.matches('^data:audio/[a-z0-9.+-]+(;codecs=[a-z0-9.]+)?;base64,[A-Za-z0-9+/=]+$')))
                         );

        /* append-only, for everyone, forever */
        allow update, delete: if false;
      }
    }

    /* ---------------------------------------------------------------- *
     *  Filed reports                                                     *
     * ---------------------------------------------------------------- *
     *  The Sheet keeps its copy and always will — it is the Chairman's
     *  window on the day. This is the copy that is signed, and it is the
     *  one the penalty ledger answers for, so it has to be impossible to
     *  forge: you file as yourself, for yourself, at a time the server
     *  sets, and nothing can be altered afterwards.                      */
    match /reports/{rid} {

      /* your own reports, and the Chairman sees everyone's */
      allow get, list: if signedIn()
                       && (isChairman() || isLedger() || resource.data.person == me());

      allow create: if signedIn()
                    /* the ledger reads; it does not report */
                    && !isLedger()
                    /* you cannot file under someone else's name */
                    && request.resource.data.by == me()
                    /* and only for yourself — unless you are the Chairman,
                       who may file on anyone's behalf; the row records that
                       it was him rather than reading as theirs */
                    && (request.resource.data.person == me() || isChairman())
                    /* the clock is the server's, so a late report cannot be
                       filed as though it arrived before the deadline */
                    && request.resource.data.at == request.time
                    && request.resource.data.report is string
                    && request.resource.data.person is string
                    && known(request.resource.data.person)
                    /* and the report must be that person's own. Every report
                       id begins with its owner's id (betty-daily, abrham-g-
                       design-daily); without this, anyone could file a
                       colleague's report under their own name and the ledger
                       would count the colleague's report as in. */
                    && request.resource.data.report.matches('^' + request.resource.data.person + '-[a-z0-9-]+$')
                    && request.resource.data.keys().hasOnly(
                         ['person','report','by','late','due','values','flags','text','lang','at'])
                    && (!('text' in request.resource.data)
                        || (request.resource.data.text is string && request.resource.data.text.size() <= 60000));

      /* a filed report is filed. A correction is a new filing. */
      allow update, delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  What the agents found                                             *
     * ---------------------------------------------------------------- *
     *  Written by the ledger account after a run, one document per day,
     *  so the Chairman can read it on his phone instead of only in an
     *  email. Nobody else can see it: it names people and what they owe. */
    match /analysis/{day} {
      /* the ledger reads a week of them back for the weekly pack */
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  The closed day, and the week and month                            *
     * ---------------------------------------------------------------- *
     *  One ledger document per day: every report that was owed, what
     *  happened to it, and what that person's letter charges for it. The
     *  monthly deductions are added up from these and nowhere else, so
     *  only the ledger account writes them. A re-run of the same day
     *  replaces the document, which is why update is allowed and delete
     *  is not.                                                           */
    match /ledger/{day} {
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }
    match /packs/{id} {
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }
    /* Every lead and KK job (apps-script/Register.js): the lines each report
       gives, kept by the script for itself, and the tables it folds them
       into, for the Chairman alone (6 Oct 2026: only him for now). */
    match /regEvents/{id} {
      allow get, list, create, update: if isLedger();
      allow delete: if false;
    }
    match /register/{id} {
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }
    /* His questions to the AI (apps-script/Ask.js). He writes the question,
       only as one waiting to be answered; the script, signed in as the
       ledger, writes the answer onto it. Nobody else reads them — they are
       about the company's money. */
    match /asks/{id} {
      allow get, list: if isChairman() || isLedger();
      allow create: if isChairman()
                    && request.resource.data.keys().hasOnly(['q', 'at', 'by', 'status'])
                    && request.resource.data.q is string
                    && request.resource.data.q.size() > 0
                    && request.resource.data.q.size() <= 1000
                    && request.resource.data.at == request.time
                    && request.resource.data.by == 'chairman'
                    && request.resource.data.status == 'asked';
      allow update: if isLedger();
      allow delete: if false;
    }
    /* His orders, for the AI to find who does each part (apps-script/
       Orders.js). He writes one as "asked"; the script writes the plan onto
       it; he sends it — the instructions themselves are written in the same
       batch, under the rule for /instructions — or drops it. He can only
       move a planned order to sent or dropped: the plan the script wrote
       stays as it was, beside what he actually sent. */
    match /orders/{id} {
      allow get, list: if isChairman() || isLedger();
      /* the AI's morning list (apps-script/Team.js, 6 Oct 2026): written by
         the script's own account as a plan, one a day, named for its day.
         It goes nowhere until he presses Send, as with his own orders. */
      allow create: if isLedger()
                    && id.matches('^ai-[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.by == 'ai'
                    && request.resource.data.status == 'planned'
                    && request.resource.data.tasks is list
                    && request.resource.data.tasks.size() <= 20
                    && request.resource.data.keys().hasOnly(
                         ['q', 'day', 'at', 'by', 'status', 'tasks', 'why', 'model', 'plannedAt', 'from']);
      allow create: if isChairman()
                    && request.resource.data.keys().hasOnly(['q', 'at', 'by', 'status'])
                    && request.resource.data.q is string
                    && request.resource.data.q.size() > 0
                    && request.resource.data.q.size() <= 1000
                    && request.resource.data.at == request.time
                    && request.resource.data.by == 'chairman'
                    && request.resource.data.status == 'asked';
      allow update: if isLedger()
                    || (isChairman()
                        && resource.data.status == 'planned'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'sentAt', 'sent'])
                        && ((request.resource.data.status == 'sent'
                             && request.resource.data.sentAt == request.time
                             && request.resource.data.sent is list
                             && request.resource.data.sent.size() > 0
                             && (request.resource.data.sent.size() <= 6
                                 || (resource.data.by == 'ai' && request.resource.data.sent.size() <= 20)))
                            || (request.resource.data.status == 'dropped'
                                && request.resource.data.sentAt == request.time)))
                    /* an order the AI asked about, or could not plan: he
                       answers or tries again (a new order — `next`), or
                       drops it, and the old card leaves his list */
                    || (isChairman()
                        && resource.data.status in ['unclear', 'failed']
                        && request.resource.data.sentAt == request.time
                        && ((request.resource.data.status == 'replaced'
                             && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['status', 'sentAt', 'next'])
                             && request.resource.data.next is string
                             && request.resource.data.next.matches('^[A-Za-z0-9_-]{6,40}$'))
                            || (request.resource.data.status == 'dropped'
                                && request.resource.data.diff(resource.data).affectedKeys()
                                     .hasOnly(['status', 'sentAt']))));
      allow delete: if false;
    }
    /* Phones that get notifications (js/fb.js, apps-script/Push.js): one
       document per phone, named for its person, holding that phone's
       Firebase Cloud Messaging address. A person writes and removes only
       their own; the script (the ledger account) reads them to send, and
       removes an address that no longer works. Nobody else sees them. */
    match /pushTokens/{tid} {
      allow get, list: if isLedger() || (signedIn() && resource.data.person == me());
      allow create, update: if signedIn() && !isLedger()
                    && tid.matches(me() + '_[0-9a-f]{8}')
                    && request.resource.data.keys().hasOnly(['person', 't', 'at', 'ua'])
                    && request.resource.data.person == me()
                    && request.resource.data.t is string
                    && request.resource.data.t.size() > 20
                    && request.resource.data.t.size() <= 4096
                    && request.resource.data.ua is string
                    && request.resource.data.ua.size() <= 300
                    && request.resource.data.at == request.time;
      allow delete: if isLedger() || (signedIn() && resource.data.person == me());
    }
    /* Which instruction went to which person's phones, and how many arrived:
       written by the script, so each is sent once; read on his page. */
    match /pushlog/{id} {
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }
    /* The month, closed: the bonuses and penalties that can only be
       judged on a whole month (waste for the month, a month with no
       complaint, the third penalty that brings a suspension). Written by
       the ledger account on the 2nd, beside the daily ledgers it reads. */
    match /months/{month} {
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }
    /* This month's bonuses so far — rewritten each morning by the ledger
       account, read on his page. Nothing in it is paid; the month's own
       close is. */
    match /standing/{month} {
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }
    /* Whether each scheduled job last worked — the morning close, the
       weekly and monthly summaries, the readings. One document per job,
       rewritten by the ledger account each time the job ends, read on his
       page so a job that failed in the night does not fail in silence. */
    match /health/{job} {
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger()
                            && job in ['daily', 'week', 'month', 'reading'];
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  A charge the Chairman cancels                                     *
     * ---------------------------------------------------------------- *
     *  The ledger charges what the letter says. A person may have a good
     *  reason — the site was down, he sent them to Adama — and only he
     *  can accept it. A cancellation names the day and the report, says
     *  why, and can never be edited or withdrawn: the deductions table
     *  shows it beside the charge it cancelled. To undo one, the charge
     *  would have to be raised again by hand, and that is deliberate.    */
    match /waivers/{wid} {
      allow get, list: if isChairman() || isLedger();
      allow create: if isChairman()
                    && request.resource.data.keys().hasOnly(
                         ['day','report','person','reason','amount','by','at'])
                    && request.resource.data.by == 'chairman'
                    && request.resource.data.at == request.time
                    && request.resource.data.day is string
                    && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.report is string
                    && request.resource.data.person is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() >= 3
                    && request.resource.data.reason.size() <= 500;
      allow update, delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  Something that happened, recorded by the Chairman                 *
     * ---------------------------------------------------------------- *
     *  Most rules in the letters are decided from the reports. Some can
     *  only be seen — rudeness to a customer, a machine used without
     *  training. He records what happened, to whom, on which day, under
     *  which rule; the amount is never typed here. The ledger looks the
     *  rule up in js/rules.js and charges (or pays) what the letter says,
     *  at the next close. A record cannot be edited or removed: to undo
     *  one, he cancels the charge it produced, with a reason, like any
     *  other.                                                            */
    match /events/{eid} {
      allow get, list: if isChairman() || isLedger();
      allow create: if isChairman()
                    && request.resource.data.keys().hasOnly(
                         ['person','name','rule','day','count','note','by','at'])
                    && request.resource.data.by == 'chairman'
                    && request.resource.data.at == request.time
                    && request.resource.data.person is string
                    && request.resource.data.person.size() > 0
                    && request.resource.data.person.size() <= 80
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.rule is string
                    && request.resource.data.rule.matches('^[a-z0-9-]{3,80}$')
                    && request.resource.data.day is string
                    && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.count is int
                    && request.resource.data.count >= 1
                    && request.resource.data.count <= 1000
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 500;
      allow update, delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  What the Chairman asked for                                       *
     * ---------------------------------------------------------------- *
     *  He gives an instruction to one person with a date. It appears on
     *  that person's home screen; they close it, once, saying what they
     *  did, at a time the server sets. He can reopen one that was not
     *  really done, or cancel one that no longer matters. Nobody else
     *  sees it, and nobody can delete it — an instruction nobody can
     *  quietly remove is the point of writing it down.                   */
    match /instructions/{iid} {
      allow get, list: if isChairman() || isLedger()
                       || (signedIn() && resource.data.to == me());

      allow create: if isChairman()
                    && request.resource.data.keys().hasOnly(
                         ['to','text','due','by','at','status'])
                    && request.resource.data.by == 'chairman'
                    && request.resource.data.status == 'open'
                    && request.resource.data.at == request.time
                    && request.resource.data.to is string
                    && request.resource.data.to.size() > 0
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.due is string
                    && request.resource.data.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      /* the script's reminders (apps-script/Credit.js): supplier credit
         falling due, to Selam and Getachew only, open, once */
      allow create: if isLedger()
                    && request.resource.data.keys().hasOnly(
                         ['to','text','due','by','at','status'])
                    && request.resource.data.by == 'reminder'
                    && request.resource.data.status == 'open'
                    && request.resource.data.at is timestamp
                    && request.resource.data.to in ['betty', 'getachew']
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.due is string
                    && request.resource.data.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      /* …and closes one when Getachew's report says the credit is paid:
         a reminder only, open to done, with the note, nothing else */
      allow update: if isLedger()
                    && resource.data.by == 'reminder'
                    && resource.data.status == 'open'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','note','doneAt'])
                    && request.resource.data.status == 'done'
                    && request.resource.data.doneAt is timestamp
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 1000;

      /* the person it is for closes it, and says what was done */
      allow update: if signedIn() && !isChairman()
                    && resource.data.to == me()
                    && resource.data.status == 'open'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','note','doneAt'])
                    && request.resource.data.status == 'done'
                    && request.resource.data.doneAt == request.time
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 1000;

      /* he reopens it or cancels it */
      allow update: if isChairman()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','closedAt'])
                    && request.resource.data.status in ['open','cancelled']
                    && request.resource.data.closedAt == request.time;

      allow delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  Asking for a run                                                  *
     * ---------------------------------------------------------------- *
     *  The Chairman presses a button; this is the button. A trigger picks
     *  it up within a few minutes and runs the agents.
     *
     *  Only he can write it, because a run costs money — anyone able to
     *  set this could spend the Gemini budget by holding down a key. */
    match /control/{doc} {
      allow get: if isChairman() || isLedger();
      allow create, update: if isChairman()
                            && request.resource.data.at == request.time;
      allow delete: if isLedger();
    }

    /* anything not named above is closed */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
