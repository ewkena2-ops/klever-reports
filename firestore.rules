rules_version = '2';

/* Klever chat — who may read and write what.

   This file is the real lock. js/channels.js decides what the phone offers to
   show; these rules decide what the server will actually hand over. Someone
   editing the JavaScript in their browser changes the first and not the
   second. Keep that distinction in mind before moving a check out of here.

   Identity is the account's email local-part: betty@klever.local is betty.
   The Chairman is chairman@klever.local.

   Messages cannot be edited or deleted by anyone, including the Chairman and
   including the person who wrote them. That is deliberate — this log feeds
   the penalty ledger, and a record that can be revised afterwards is not
   evidence of anything. To correct something, write another message.

   PASTE THIS INTO: Firebase console -> Firestore Database -> Rules -> Publish.  */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email is string;
    }

    /* the Klever id behind the account doing the asking */
    function me() {
      return request.auth.token.email.split('@')[0].lower();
    }

    function isChairman() {
      return signedIn() && me() == 'chairman';
    }

    /* The penalty ledger's own account. It reads filed reports and nothing
       else — it cannot write one, cannot touch chat, and cannot alter
       anything. It exists so that the nightly job does not have to carry the
       Chairman's password around in a script property, and so that if it ever
       leaks, what leaks is a reader. */
    function isLedger() {
      return signedIn() && me() == 'ledger';
    }

    /* one read of the channel document, cached for the rest of this request */
    function memberOf(cid) {
      return signedIn()
          && me() in get(/databases/$(database)/documents/channels/$(cid)).data.members;
    }

    match /channels/{cid} {

      /* you can see a channel you are in. Note this covers `get` only — the
         app never lists channels from the server, it builds the list from
         channels.js, so there is no listing to protect here. */
      allow get: if signedIn() && me() in resource.data.members;

      /* only the Chairman defines channels and who is in them. This is the
         Set up channels button on his phone. */
      allow list, create, update: if isChairman();
      allow delete: if false;

      match /messages/{mid} {

        allow read: if memberOf(cid);

        allow create: if memberOf(cid)
                      /* you can only write as yourself */
                      && request.resource.data.who == me()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 4000
                      /* the time comes from the server, so nobody can file a
                         message as though it were sent before a deadline */
                      && request.resource.data.at == request.time
                      && request.resource.data.keys().hasOnly(
                           ['who','text','lang','at','kind','media','mime','dur','w','h'])
                      /* either it says something, or it carries something */
                      && (
                           (!('kind' in request.resource.data)
                             && request.resource.data.text.size() > 0)
                           ||
                           (request.resource.data.kind in ['image','voice']
                             && request.resource.data.media is string
                             && request.resource.data.media.size() > 0
                             /* a Firestore document caps at 1 MiB and base64
                                inflates by a third, so the client shrinks a
                                photo until it fits. This is the backstop —
                                without it one oversized send makes a channel
                                expensive for every phone that opens it. */
                             && request.resource.data.media.size() < 700000)
                         );

        /* append-only, for everyone, forever */
        allow update, delete: if false;
      }
    }

    /* ---------------------------------------------------------------- *
     *  Filed reports                                                     *
     * ---------------------------------------------------------------- *
     *  The Sheet keeps its copy and always will — it is the Chairman's
     *  window on the day. This is the copy that is signed, and it is the
     *  one the penalty ledger answers for, so it has to be impossible to
     *  forge: you file as yourself, for yourself, at a time the server
     *  sets, and nothing can be altered afterwards.                      */
    match /reports/{rid} {

      /* your own reports, and the Chairman sees everyone's */
      allow get, list: if signedIn()
                       && (isChairman() || isLedger() || resource.data.person == me());

      allow create: if signedIn()
                    /* the ledger reads; it does not report */
                    && !isLedger()
                    /* you cannot file under someone else's name */
                    && request.resource.data.by == me()
                    /* and only for yourself — unless you are the Chairman,
                       who may file on anyone's behalf; the row records that
                       it was him rather than reading as theirs */
                    && (request.resource.data.person == me() || isChairman())
                    /* the clock is the server's, so a late report cannot be
                       filed as though it arrived before the deadline */
                    && request.resource.data.at == request.time
                    && request.resource.data.report is string
                    && request.resource.data.person is string;

      /* a filed report is filed. A correction is a new filing. */
      allow update, delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  What the agents found                                             *
     * ---------------------------------------------------------------- *
     *  Written by the ledger account after a run, one document per day,
     *  so the Chairman can read it on his phone instead of only in an
     *  email. Nobody else can see it: it names people and what they owe. */
    match /analysis/{day} {
      /* the ledger reads a week of them back for the weekly pack */
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  The closed day, and the week and month                            *
     * ---------------------------------------------------------------- *
     *  One ledger document per day: every report that was owed, what
     *  happened to it, and what that person's letter charges for it. The
     *  monthly deductions are added up from these and nowhere else, so
     *  only the ledger account writes them. A re-run of the same day
     *  replaces the document, which is why update is allowed and delete
     *  is not.                                                           */
    match /ledger/{day} {
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }
    match /packs/{id} {
      allow get, list: if isChairman() || isLedger();
      allow create, update: if isLedger();
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  A charge the Chairman cancels                                     *
     * ---------------------------------------------------------------- *
     *  The ledger charges what the letter says. A person may have a good
     *  reason — the site was down, he sent them to Adama — and only he
     *  can accept it. A cancellation names the day and the report, says
     *  why, and can never be edited or withdrawn: the deductions table
     *  shows it beside the charge it cancelled. To undo one, the charge
     *  would have to be raised again by hand, and that is deliberate.    */
    match /waivers/{wid} {
      allow get, list: if isChairman() || isLedger();
      allow create: if isChairman()
                    && request.resource.data.keys().hasOnly(
                         ['day','report','person','reason','amount','by','at'])
                    && request.resource.data.by == 'chairman'
                    && request.resource.data.at == request.time
                    && request.resource.data.day is string
                    && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.report is string
                    && request.resource.data.person is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() >= 3
                    && request.resource.data.reason.size() <= 500;
      allow update, delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  What the Chairman asked for                                       *
     * ---------------------------------------------------------------- *
     *  He gives an instruction to one person with a date. It appears on
     *  that person's home screen; they close it, once, saying what they
     *  did, at a time the server sets. He can reopen one that was not
     *  really done, or cancel one that no longer matters. Nobody else
     *  sees it, and nobody can delete it — an instruction nobody can
     *  quietly remove is the point of writing it down.                   */
    match /instructions/{iid} {
      allow get, list: if isChairman() || isLedger()
                       || (signedIn() && resource.data.to == me());

      allow create: if isChairman()
                    && request.resource.data.keys().hasOnly(
                         ['to','text','due','by','at','status'])
                    && request.resource.data.by == 'chairman'
                    && request.resource.data.status == 'open'
                    && request.resource.data.at == request.time
                    && request.resource.data.to is string
                    && request.resource.data.to.size() > 0
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.due is string
                    && request.resource.data.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      /* the person it is for closes it, and says what was done */
      allow update: if signedIn() && !isChairman()
                    && resource.data.to == me()
                    && resource.data.status == 'open'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','note','doneAt'])
                    && request.resource.data.status == 'done'
                    && request.resource.data.doneAt == request.time
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 1000;

      /* he reopens it or cancels it */
      allow update: if isChairman()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','closedAt'])
                    && request.resource.data.status in ['open','cancelled']
                    && request.resource.data.closedAt == request.time;

      allow delete: if false;
    }

    /* ---------------------------------------------------------------- *
     *  Asking for a run                                                  *
     * ---------------------------------------------------------------- *
     *  The Chairman presses a button; this is the button. A trigger picks
     *  it up within a few minutes and runs the agents.
     *
     *  Only he can write it, because a run costs money — anyone able to
     *  set this could spend the Gemini budget by holding down a key. */
    match /control/{doc} {
      allow get: if isChairman() || isLedger();
      allow create, update: if isChairman()
                            && request.resource.data.at == request.time;
      allow delete: if isLedger();
    }

    /* anything not named above is closed */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
